local function toggle(pg, nome, chave)
local f = linha(pg)
rotulo(f, nome)
local b = botaoDireita(f, "")
local function ref()
b.Text = cfg[chave] and "ON" or "OFF"
b.BackgroundColor3 = cfg[chave] and Color3.fromRGB(0, 140, 70) or Color3.fromRGB(35, 35, 35)
end
ref()
b.MouseButton1Click:Connect(function() cfg[chave] = not cfg[chave] ref() end)
end

local function ciclo(pg, nome, chave, opcoes)
local f = linha(pg)
rotulo(f, nome)
local b = botaoDireita(f, cfg[chave], 90)
b.MouseButton1Click:Connect(function()
local i = table.find(opcoes, cfg[chave]) or 1
cfg[chave] = opcoes[i % #opcoes + 1]
b.Text = cfg[chave]
end)
end

local function passo(pg, nome, chave, delta, minimo, maximo, casas)
local f = linha(pg)
rotulo(f, nome)
local mais = botaoDireita(f, "+", 26)
local val = Instance.new("TextLabel")
val.Size = UDim2.new(0, 46, 0, 22)
val.Position = UDim2.new(1, -8 - 26 - 4 - 46, 0.5, -11)
val.BackgroundTransparency = 1
val.TextColor3 = ACCENT
val.Font = Enum.Font.GothamBold
val.TextSize = 12
val.Parent = f
local menos = botaoDireita(f, "-", 26)
menos.Position = UDim2.new(1, -8 - 26 - 4 - 46 - 4 - 26, 0.5, -11)
local function ref() val.Text = string.format("%." .. (casas or 0) .. "f", cfg[chave]) end
ref()
mais.MouseButton1Click:Connect(function() cfg[chave] = math.min(maximo, cfg[chave] + delta) ref() end)
menos.MouseButton1Click:Connect(function() cfg[chave] = math.max(minimo, cfg[chave] - delta) ref() end)
end

