local esp = {} -- [player] = {hl, linha, bb, txt}

local function criarESP(plr)
local d = {}
d.linha = Instance.new("Frame")
d.linha.AnchorPoint = Vector2.new(0.5, 0.5)
d.linha.BorderSizePixel = 0
d.linha.Visible = false
d.linha.Parent = gui

d.hl = Instance.new("Highlight")
d.hl.FillTransparency = 0.55
d.hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
d.hl.Enabled = false
d.hl.Parent = gui -- Adornee definido depois

d.txt = Instance.new("TextLabel")
d.txt.AnchorPoint = Vector2.new(0.5, 1)
d.txt.Size = UDim2.new(0, 160, 0, 30)
d.txt.BackgroundTransparency = 1
d.txt.Font = Enum.Font.GothamBold
d.txt.TextSize = 12
d.txt.TextStrokeTransparency = 0.4
d.txt.Visible = false
d.txt.Parent = gui

