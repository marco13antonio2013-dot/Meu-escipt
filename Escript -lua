local function limparESP(plr)
local d = esp[plr]
if d then
d.linha:Destroy() d.hl:Destroy() d.txt:Destroy()
esp[plr] = nil
end
end
Players.PlayerRemoving:Connect(limparESP)

local function origemLinha(cam)
local tela = cam.ViewportSize
if cfg.OrigemLinha == "Baixo" then return Vector2.new(tela.X / 2, tela.Y)
elseif cfg.OrigemLinha == "Centro" then return tela / 2 end
return UIS:GetMouseLocation()
end

local function atualizarESP(cam)
local cor = corAtual()
for _, plr in ipairs(Players:GetPlayers()) do
if plr ~= lp then
local d = esp[plr] or criarESP(plr)
if cfg.ESP and valido(plr) then
local char = plr.Character
local root = char.HumanoidRootPart
local hum = char:FindFirstChildOfClass("Humanoid")

-- contorno
d.hl.Adornee = char
d.hl.FillColor, d.hl.OutlineColor = cor, cor
d.hl.Enabled = cfg.Contorno

local pos, visivel = cam:WorldToViewportPoint(root.Position)
-- linha
if cfg.Linha and visivel then
local a, b = origemLinha(cam), Vector2.new(pos.X, pos.Y)
local v = b - a
d.linha.Size = UDim2.new(0, v.Magnitude, 0, 2)
d.linha.Position = UDim2.new(0, (a.X + b.X) / 2, 0, (a.Y + b.Y) / 2)
d.linha.Rotation = math.deg(math.atan2(v.Y, v.X))
d.linha.BackgroundColor3 = cor
d.linha.Visible = true
else
d.linha.Visible = false
end
-- texto
if cfg.Nome and visivel then
local dist = (cam.CFrame.Position - root.Position).Magnitude
d.txt.Text = string.format("%s\n[%dm] [%d HP]", plr.DisplayName, dist, hum.Health)
d.txt.TextColor3 = cor
local topo = cam:WorldToViewportPoint(root.Position + Vector3.new(0, 3.2, 0))
d.txt.Position = UDim2.new(0, topo.X, 0, topo.Y)
d.txt.Visible = true
else
d.txt.Visible = false
end
else
d.hl.Enabled, d.linha.Visible, d.txt.Visible = false, false, false
end
end
end
end

---------------------------------------------------------------- Aimbot (Normal / Agressivo)
local circulo = Instance.new("Frame")
circulo.AnchorPoint = Vector2.new(0.5, 0.5)
circulo.BackgroundTransparency = 1
circulo.Parent = gui
Instance.new("UICorner", circulo).CornerRadius = UDim.new(1, 0)
local cstroke = Instance.new("UIStroke", circulo)
cstroke.Thickness = 1.5

local alvoAtual = nil

local function semParede(cam, parte, char)
local p = RaycastParams.new()
p.FilterType = Enum.RaycastFilterType.Exclude
p.FilterDescendantsInstances = { lp.Character }
local r = workspace:Raycast(cam.CFrame.Position, parte.Position - cam.CFrame.Position, p)
return r == nil or r.Instance:IsDescendantOf(char)
end

local function distMira(cam, parte)
local pos, vis = cam:WorldToViewportPoint(parte.Position)
if not vis then return math.huge end
return (Vector2.new(pos.X, pos.Y) - UIS:GetMouseLocation()).Magnitude
end

local function angulo(cam, parte)
local dir = (parte.Position - cam.CFrame.Position).Unit
return math.acos(math.clamp(cam.CFrame.LookVector:Dot(dir), -1, 1))
end

-- retorna a "pontuação" do alvo (menor = melhor) ou nil se não serve
local function pontuar(cam, plr, m)
local parte = parteAlvo(plr.Character)
if not parte then return nil end
if m.Parede and not semParede(cam, parte, plr.Character) then return nil end
if m.PorAngulo then
return angulo(cam, parte)
end
local d = distMira(cam, parte)
return d <= m.FOV and d or nil
end

local function escolherAlvo(cam, m)
-- Agressivo: mantém o alvo até ele morrer. Normal: só enquanto estiver na mira.
if alvoAtual and valido(alvoAtual) then
if m.PorAngulo then return alvoAtual end
local parte = parteAlvo(alvoAtual.Character)
if parte and distMira(cam, parte) <= m.FOV * 1.3 and semParede(cam, parte, alvoAtual.Character) then
return alvoAtual
end
end
local melhor, menor = nil, math.huge
for _, plr in ipairs(Players:GetPlayers()) do
if valido(plr) then
local s = pontuar(cam, plr, m)
if s and s < menor then menor, melhor = s, plr end
end
end
return melhor
end

local function aimStep()
local cam = workspace.CurrentCamera
local m = modos[cfg.Modo]
local mouse = UIS:GetMouseLocation()

circulo.Visible = cfg.Aimbot and cfg.MostrarFOV and not m.PorAngulo
if m.FOV ~= math.huge then
circulo.Size = UDim2.new(0, m.FOV * 2, 0, m.FOV * 2)
end
circulo.Position = UDim2.new(0, mouse.X, 0, mouse.Y)
cstroke.Color = corAtual()

if not cfg.Aimbot then alvoAtual = nil return end
alvoAtual = escolherAlvo(cam, m)
if alvoAtual then
local parte = parteAlvo(alvoAtual.Character)
local olhar = CFrame.new(cam.CFrame.Position, parte.Position)
cam.CFrame = (m.Suavidade >= 1) and olhar or cam.CFrame:Lerp(olhar, m.Suavidade)
end
end

-- roda DEPOIS da câmera do Roblox para ela não sobrescrever a mira
RunService:BindToRenderStep("MarcoHubAim", Enum.RenderPriority.Camera.Value + 1, function()
local cam = workspace.CurrentCamera
atualizarESP(cam)
aimStep()
end)
